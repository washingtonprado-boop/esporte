rules_version = '2';

/**
 * Estrutura de pastas esperada no Storage:
 *   /campeonatos/{campeonatoId}/banner.jpg
 *   /times/{timeId}/logo.jpg
 *   /atletas/{atletaId}/foto.jpg
 *
 * Limite de 5MB por arquivo e apenas imagens — ajuste os tipos aceitos
 * em `tipoValido()` se precisar de outros formatos.
 */

service firebase.storage {
  match /b/{bucket}/o {

    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return logado() &&
             firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
             meuPerfil().tipo == 'admin' &&
             meuPerfil().status == 'ativo';
    }

    function souDonoDoTime(timeId) {
      return logado() &&
             firestore.exists(/databases/(default)/documents/times/$(timeId)) &&
             firestore.get(/databases/(default)/documents/times/$(timeId)).data.responsavelUid == request.auth.uid;
    }

    function souDonoDoAtleta(atletaId) {
      return logado() &&
             firestore.exists(/databases/(default)/documents/atletas/$(atletaId)) &&
             souDonoDoTime(firestore.get(/databases/(default)/documents/atletas/$(atletaId)).data.timeId);
    }

    function tamanhoValido() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function tipoValido() {
      return request.resource.contentType.matches('image/.*');
    }

    // Banners/logos de campeonato — só admin
    match /campeonatos/{campeonatoId}/{arquivo} {
      allow read: if true;
      allow write: if souAdmin() && tamanhoValido() && tipoValido();
    }

    // Logo do time — admin ou o próprio responsável do time
    match /times/{timeId}/{arquivo} {
      allow read: if true;
      allow write: if (souAdmin() || souDonoDoTime(timeId)) && tamanhoValido() && tipoValido();
    }

    // Foto do atleta — admin ou responsável do time do atleta
    match /atletas/{atletaId}/{arquivo} {
      allow read: if true;
      allow write: if (souAdmin() || souDonoDoAtleta(atletaId)) && tamanhoValido() && tipoValido();
    }

    // Qualquer outro caminho: bloqueado por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
